@{
    int code = (int)(ViewData["StatusCode"] ?? 500);
    string title = code == 404 ? "Sayfa Bulunamadı" : "Bir Hata Oluştu";
    string message = code == 404
        ? "Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir."
        : "İşlem sırasında beklenmedik bir sorun oluştu. Lütfen tekrar deneyin.";
    string icon = code == 404 ? "bi-signpost-split" : "bi-exclamation-octagon";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <i class="bi @icon" style="font-size: 4rem; color: var(--brand);"></i>
    <div class="fs-1 fw-bold mt-3">@code</div>
    <div class="fs-5 fw-semibold mb-1">@title</div>
    <div class="text-muted mb-4" style="max-width: 400px;">@message</div>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house-door"></i> Dashboard'a Dön
    </a>
</div>