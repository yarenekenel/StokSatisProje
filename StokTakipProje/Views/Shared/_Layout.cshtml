<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StokTakip</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-boxes"></i> StokTakip
            </div>
            <nav class="sidebar-nav">
                <div class="nav-group-title">Genel</div>
                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

                <div class="nav-group-title">Kartlar</div>
                <a class="nav-link" asp-controller="Unit" asp-action="Index"><i class="bi bi-rulers"></i> Birimler</a>
                <a class="nav-link" asp-controller="Currency" asp-action="Index"><i class="bi bi-currency-exchange"></i> Para Birimleri</a>
                <a class="nav-link" asp-controller="ProductType" asp-action="Index"><i class="bi bi-tags"></i> Ürün Tipleri</a>
                <a class="nav-link" asp-controller="StockType" asp-action="Index"><i class="bi bi-layers"></i> Stok Tipleri</a>
                <a class="nav-link" asp-controller="Company" asp-action="Index"><i class="bi bi-building"></i> Firmalar</a>
                <a class="nav-link" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Ürünler</a>
                <a class="nav-link" asp-controller="Project" asp-action="Index"><i class="bi bi-kanban"></i> Projeler</a>
                <a class="nav-link" asp-controller="Machine" asp-action="Index"><i class="bi bi-gear-wide-connected"></i> Makinalar</a>
                <a class="nav-link" asp-controller="ProjectMachine" asp-action="Index"><i class="bi bi-link-45deg"></i> Proje-Makina Atama</a>

                <div class="nav-group-title">Stok</div>
                <a class="nav-link" asp-controller="StockEntry" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i> Stok Girişi</a>
                <a class="nav-link" asp-controller="StockIssue" asp-action="Index"><i class="bi bi-box-arrow-up"></i> Stok Çıkışı</a>

                <div class="nav-group-title">Raporlar</div>
                <a class="nav-link" asp-controller="Reports" asp-action="StockBalance"><i class="bi bi-bar-chart"></i> Stok Bakiye</a>
                <a class="nav-link" asp-controller="Reports" asp-action="ProjectCost"><i class="bi bi-cash-stack"></i> Proje Maliyet</a>
                <a class="nav-link" asp-controller="MachineReports" asp-action="Index"><i class="bi bi-cpu"></i> Makina Raporları</a>

                <div class="nav-group-title">Sistem</div>
                <a class="nav-link" asp-controller="User" asp-action="Index"><i class="bi bi-people"></i> Kullanıcı Yönetimi</a>
                <a class="nav-link" asp-controller="Role" asp-action="Index"><i class="bi bi-shield-lock"></i> Rol Yönetimi</a>
            </nav>
        </aside>

        <div class="main-area">
            <header class="topbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <button class="btn btn-sm d-md-none me-2" id="sidebarToggle" type="button">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <span class="topbar-title">@ViewData["Title"]</span>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> Çıkış Yap
                        </a>
                    </div>
                }
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
                <text>
                Swal.fire({ icon: 'success', title: 'Başarılı', text: '@Html.Raw(successMessage)', confirmButtonText: 'Tamam' });
                </text>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
                <text>
                Swal.fire({ icon: 'error', title: 'Hata', text: '@Html.Raw(errorMessage)', confirmButtonText: 'Tamam' });
                </text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>