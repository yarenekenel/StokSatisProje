@model IReadOnlyList<StockType>
@{
    ViewData["Title"] = "Stok Tipleri";
}

<div class="mb-2">
    <input type="text" id="stockTypeSearchInput" class="form-control form-control-sm" placeholder="Stok tipi adına göre ara...">
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <button type="button" class="btn btn-primary btn-sm" onclick="openCreateModal()">
        <i class="bi bi-plus-lg"></i> Yeni Stok Tipi Ekle
    </button>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> Yazdır
        </button>
        <a class="btn btn-outline-danger btn-sm" href="@Url.Action("ExportPdf")">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
        <a class="btn btn-outline-success btn-sm" href="@Url.Action("Export")">
            <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
        </a>
    </div>
</div>

<div class="card">
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th style="width: 140px;" class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody id="stockTypeTableBody">
                @if (Model is null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-4">Henüz stok tipi eklenmemiş.</td>
                    </tr>
                }
                else
                {
                        foreach (var item in Model)
                        {
                        <tr data-search-row data-search-text="@(item.Name.ToLower())">
                        <td>@item.Name</td>
                        <td class="text-end">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        onclick='openEditModal(@item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Name)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick='confirmDelete(@item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Name)))'>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="stockTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="stockTypeForm" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="stockTypeModalTitle">Yeni Stok Tipi Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="stockTypeId" />
                    <div class="mb-3">
                        <label class="form-label">Ad</label>
                        <input type="text" name="name" id="stockTypeName" class="form-control" required maxlength="50" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;"></form>

@section Scripts {
    <script>
        enableLiveSearch('stockTypeSearchInput', 'stockTypeTableBody');
        const stockTypeModal = new bootstrap.Modal(document.getElementById('stockTypeModal'));

        function openCreateModal() {
            document.getElementById('stockTypeModalTitle').innerText = 'Yeni Stok Tipi Ekle';
            document.getElementById('stockTypeForm').action = '@Url.Action("Create", "StockType")';
            document.getElementById('stockTypeId').value = '';
            document.getElementById('stockTypeName').value = '';
            stockTypeModal.show();
        }

        function openEditModal(id, name) {
            document.getElementById('stockTypeModalTitle').innerText = 'Stok Tipini Düzenle';
            document.getElementById('stockTypeForm').action = '@Url.Action("Edit", "StockType")';
            document.getElementById('stockTypeId').value = id;
            document.getElementById('stockTypeName').value = name;
            stockTypeModal.show();
        }

        function confirmDelete(id, name) {
            Swal.fire({
                icon: 'warning',
                title: 'Emin misiniz?',
                text: `"${name}" stok tipi silinecek.`,
                showCancelButton: true,
                confirmButtonText: 'Evet, sil',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#c0392b'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('deleteForm');
                    form.action = '@Url.Action("Delete", "StockType")/' + id;
                    form.submit();
                }
            });
        }
    </script>
}