@model IReadOnlyList<ProjectMachineListDto>
@{
    ViewData["Title"] = "Proje-Makina Atamaları";
    int? currentProjectId = ViewData["CurrentProjectId"] as int?;
    var projects = (IReadOnlyList<ProjectListDto>)ViewBag.Projects;
    var machines = (IReadOnlyList<Machine>)ViewBag.Machines;
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <button type="button" class="btn btn-primary btn-sm" onclick="openAssignModal()">
        <i class="bi bi-link-45deg"></i> Yeni Atama
    </button>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> Yazdır
        </button>
        <a class="btn btn-outline-danger btn-sm" href="@Url.Action("ExportPdf", new { projectId = currentProjectId })">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
        <a class="btn btn-outline-success btn-sm" href="@Url.Action("Export", new { projectId = currentProjectId })">
            <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
        </a>
    </div>
</div>

<div class="card">
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0">Projeye göre filtrele:</label>
            <select name="projectId" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                <option value="">Tüm Projeler</option>
                @foreach (var p in projects)
                {
                    if (currentProjectId == p.Id)
                    {
                        <option value="@p.Id" selected>@p.ProjectCode - @p.CompanyName</option>
                    }
                    else
                    {
                        <option value="@p.Id">@p.ProjectCode - @p.CompanyName</option>
                    }
                }
            </select>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Proje</th>
                    <th>Makina Kodu</th>
                    <th>Makina Adı</th>
                    <th>Atama Tarihi</th>
                    <th style="width: 100px;" class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProjectCode</td>
                            <td><span class="badge bg-secondary">@item.MachineCode</span></td>
                            <td>@item.MachineName</td>
                            <td>@item.AssignedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick='confirmUnassign(@item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.MachineName)))'>
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="assignForm" method="post" action="@Url.Action("Assign", "ProjectMachine")">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Atama</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Proje</label>
                        <select name="projectId" class="form-select" required>
                            <option value="">Seçiniz</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.Id">@p.ProjectCode - @p.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Makina</label>
                        <select name="machineId" class="form-select" required>
                            <option value="">Seçiniz</option>
                            @foreach (var m in machines)
                            {
                                <option value="@m.Id">@m.Code - @m.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">Ata</button>
                </div>
            </div>
        </form>
    </div>
</div>

<form id="unassignForm" method="post" style="display:none;"></form>

@section Scripts {
    <script>
        const assignModal = new bootstrap.Modal(document.getElementById('assignModal'));

        function openAssignModal() {
            document.getElementById('assignForm').reset();
            assignModal.show();
        }

        function confirmUnassign(id, machineName) {
            Swal.fire({
                icon: 'warning',
                title: 'Emin misiniz?',
                text: `"${machineName}" ataması kaldırılacak.`,
                showCancelButton: true,
                confirmButtonText: 'Evet, kaldır',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#c0392b'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('unassignForm');
                    form.action = '@Url.Action("Unassign", "ProjectMachine")/' + id;
                    form.submit();
                }
            });
        }
    </script>
}